FROM registry.access.redhat.com/ubi10/ubi-minimal:latest

ARG TEST_IMAGE=false

USER root

ENV APP_ROOT=/opt/app-root/src
WORKDIR $APP_ROOT

# PostgreSQL 16 is the default stream on RHEL/UBI 10 (no modules).
RUN microdnf upgrade -y && \
    microdnf install --setopt=tsflags=nodocs -y postgresql python3.14 python3.14-pip rsync tar procps-ng make && \
    rpm -qa | sort > packages-before-devel-install.txt && \
    microdnf install --setopt=tsflags=nodocs -y libpq-devel python3.14-devel gcc libatomic cargo rust && \
    rpm -qa | sort > packages-after-devel-install.txt && \
    ln -s /usr/bin/python3.14 /usr/bin/python && \
    ln -s /usr/bin/python3.14 /usr/bin/python3

COPY api/ api/
COPY app/ app/
COPY lib/ lib/
COPY migrations/ migrations/
COPY swagger/ swagger/
COPY tests/ tests/
COPY utils/ utils/
COPY mk/ mk/
COPY Makefile Makefile
COPY gunicorn.conf.py gunicorn.conf.py
COPY inv_mq_service.py inv_mq_service.py
COPY inv_export_service.py inv_export_service.py
COPY logconfig.yaml logconfig.yaml
COPY manage.py manage.py
COPY pyproject.toml pyproject.toml
COPY uv.lock uv.lock
COPY uv-build-version uv-build-version
COPY scripts/get_uv_pip_specifier.py scripts/get_uv_pip_specifier.py
COPY pytest.ini pytest.ini
COPY run_gunicorn.py run_gunicorn.py
COPY run_command.sh run_command.sh
COPY run.py run.py
COPY jobs/ jobs/

ENV PIP_NO_CACHE_DIR=1
ENV UV_COMPILE_BYTECODE=1

RUN UV_SPEC=$(python3.14 scripts/get_uv_pip_specifier.py --build-pin) && \
    python3.14 -m pip install --upgrade pip setuptools wheel && \
    python3.14 -m pip install "uv${UV_SPEC}" dumb-init && \
    uv sync --frozen && \
    chown -R 1001:0 "$APP_ROOT/.venv"

ENV PATH="$APP_ROOT/.venv/bin:$PATH"

# allows pre-commit and unit tests to run successfully within the container if image is built in "test" environment
RUN if [ "$TEST_IMAGE" = "true" ]; then \
        microdnf install --setopt=tsflags=nodocs -y git nodejs npm which && \
        chgrp -R 0 $APP_ROOT && \
        chmod -R g=u $APP_ROOT ; \
    fi

# remove devel packages that were only necessary for psycopg2 to compile
RUN microdnf remove  -y  libpq-devel python3.14-devel gcc cargo rust rust-std-static && \
    microdnf clean all

USER 1001

ENTRYPOINT [ "dumb-init", "--single-child", "./run_command.sh" ]
