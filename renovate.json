{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>RedHatInsights/konflux-pipelines//renovate/foreman_satellite/renovate.json"
  ],
  "ignorePaths": [
    "Pipfile.iqe",
    ".hermetic_builds/**"
  ],
  "constraints": {
    "python": "3.12"
  },
  "tekton": {
    "schedule": [
      "at any time"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "pip-compile": {
    "enabled": false
  },
  "packageRules": [
    {
      "groupName": "openapi",
      "matchPackageNames": [
        "/^openapi-/"
      ]
    },
    {
      "groupName": "opentelemetry-and-sqlalchemy",
      "ignoreUnstable": false,
      "matchPackageNames": [
        "/^opentelemetry-/",
        "sqlalchemy"
      ]
    }
  ]
}
