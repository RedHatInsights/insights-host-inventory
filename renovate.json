{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>RedHatInsights/konflux-pipelines//renovate/foreman_satellite/renovate.json"
  ],
  "ignorePaths": [
    "Pipfile.iqe",
    ".hermetic_builds/**"
  ],
  "constraints": {
    "python": "3.12"
  },
  "tekton": {
    "schedule": [
      "at any time"
    ]
  },
  "pip_requirements": {
    "enabled": false
  },
  "pip-compile": {
    "enabled": false
  },
  "pep621": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Automerge non-major updates",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Keep Python dependency PR volume consistent with the former Dependabot limit",
      "matchManagers": [
        "pep621"
      ],
      "prConcurrentLimit": 3,
      "addLabels": [
        "dependencies"
      ]
    },
    {
      "description": "Label GitHub Actions dependency updates",
      "matchManagers": [
        "github-actions"
      ],
      "addLabels": [
        "GitHub-Actions-Updates"
      ]
    },
    {
      "groupName": "openapi",
      "matchPackageNames": [
        "/^openapi-/"
      ]
    },
    {
      "groupName": "opentelemetry-and-sqlalchemy",
      "ignoreUnstable": false,
      "matchPackageNames": [
        "/^opentelemetry-/",
        "sqlalchemy"
      ]
    }
  ]
}
